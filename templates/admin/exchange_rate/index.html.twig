{% extends 'base.html.twig' %}

{% block title %}Exchange Rates{% endblock %}

{% block body %}

{# ══════════════════════════════════════════
   Stats row
   ══════════════════════════════════════════ #}
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card stat-card">
            <div class="stat-value">{{ totalPairs }}</div>
            <div class="stat-label">Currency Pairs</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card stat-card">
            <div class="stat-value">{{ currencies|length }}</div>
            <div class="stat-label">Active Currencies</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card stat-card">
            <div class="stat-value" id="statLastSync">
                {{ lastSyncedAt ? lastSyncedAt|date('H:i') : '—' }}
            </div>
            <div class="stat-label">
                Last Sync
                {% if lastSyncedAt %}
                    ({{ lastSyncedAt|date('d M Y') }})
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card stat-card d-flex align-items-center justify-content-center">
            <button class="btn btn-sync" id="btnSync" onclick="syncRates()">
                <i class="bi bi-arrow-repeat me-1"></i>Sync Rates
            </button>
        </div>
    </div>
</div>

<div class="row g-4">

{# ══════════════════════════════════════════
   Converter card
   ══════════════════════════════════════════ #}
<div class="col-lg-4">
    <div class="card">
        <div class="card-header d-flex align-items-center">
            <i class="bi bi-calculator me-2"></i>Currency Converter
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label for="convertAmount" class="form-label small fw-semibold">Amount</label>
                <input type="number" class="form-control" id="convertAmount"
                       placeholder="100.00" step="0.01" min="0.01" value="100">
            </div>
            <div class="mb-3">
                <label for="convertFrom" class="form-label small fw-semibold">From</label>
                <select class="form-select" id="convertFrom">
                    {% for c in currencies %}
                        <option value="{{ c.code }}" {{ c.code == 'USD' ? 'selected' : '' }}>
                            {{ c.code }} — {{ c.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="text-center mb-3">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle"
                        onclick="swapCurrencies()" title="Swap">
                    <i class="bi bi-arrow-down-up"></i>
                </button>
            </div>

            <div class="mb-3">
                <label for="convertTo" class="form-label small fw-semibold">To</label>
                <select class="form-select" id="convertTo">
                    {% for c in currencies %}
                        <option value="{{ c.code }}" {{ c.code == 'EUR' ? 'selected' : '' }}>
                            {{ c.code }} — {{ c.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <button class="btn btn-sync w-100" id="btnConvert" onclick="doConvert()">
                <i class="bi bi-arrow-left-right me-1"></i>Convert
            </button>

            {# ── Result ── #}
            <div class="converter-result mt-3" id="convertResult">
                <div class="alert alert-light border text-center mb-0">
                    <div class="text-muted small" id="resultOriginal"></div>
                    <div class="fs-4 fw-bold text-primary" id="resultConverted"></div>
                    <div class="text-muted small mt-1" id="resultRate"></div>
                </div>
            </div>

            {# ── Error ── #}
            <div class="converter-result mt-3" id="convertError">
                <div class="alert alert-danger mb-0 small" id="convertErrorMsg"></div>
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════
   Rates table
   ══════════════════════════════════════════ #}
<div class="col-lg-8">
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span><i class="bi bi-table me-2"></i>Exchange Rates</span>
            <input type="text" class="search-input" id="searchInput"
                   placeholder="Filter by currency…" oninput="filterTable()">
        </div>
        <div class="card-body p-0">
            {% if rates|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover" id="ratesTable">
                        <thead>
                            <tr>
                                <th data-col="0" onclick="sortTable(0)">
                                    Base <i class="bi bi-arrow-down-up sort-icon"></i>
                                </th>
                                <th data-col="1" onclick="sortTable(1)">
                                    Target <i class="bi bi-arrow-down-up sort-icon"></i>
                                </th>
                                <th data-col="2" onclick="sortTable(2)">
                                    Rate <i class="bi bi-arrow-down-up sort-icon"></i>
                                </th>
                                <th data-col="3" onclick="sortTable(3)">
                                    Updated <i class="bi bi-arrow-down-up sort-icon"></i>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="ratesBody">
                            {% for rate in rates %}
                                <tr>
                                    <td>
                                        <span class="badge-currency">{{ rate.baseCurrency.code }}</span>
                                        <span class="text-muted small ms-1">{{ rate.baseCurrency.name }}</span>
                                    </td>
                                    <td>
                                        <span class="badge-currency">{{ rate.targetCurrency.code }}</span>
                                        <span class="text-muted small ms-1">{{ rate.targetCurrency.name }}</span>
                                    </td>
                                    <td>
                                        <span class="rate-value">{{ rate.rate|number_format(6, '.', ',') }}</span>
                                    </td>
                                    <td class="text-muted small">
                                        {{ rate.fetchedAt|date('d M Y, H:i') }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white text-muted small text-end" id="tableFooter">
                    Showing {{ rates|length }} pairs
                </div>
            {% else %}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    No exchange rates yet. Click <strong>Sync Rates</strong> to fetch them.
                </div>
            {% endif %}
        </div>
    </div>
</div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    'use strict';

    // ── Convert ─────────────────────────────
    window.doConvert = async function () {
        const btn = document.getElementById('btnConvert');
        const resultEl = document.getElementById('convertResult');
        const errorEl = document.getElementById('convertError');

        resultEl.classList.remove('show');
        errorEl.classList.remove('show');

        const amount = document.getElementById('convertAmount').value;
        const from = document.getElementById('convertFrom').value;
        const to = document.getElementById('convertTo').value;

        if (!amount || parseFloat(amount) <= 0) {
            showError('Please enter a positive amount.');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-inline"></span>Converting…';

        try {
            const res = await fetch('{{ path("admin_exchange_rates_convert") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount, from, to }),
            });

            const data = await res.json();

            if (!res.ok || data.error) {
                showError(data.error || 'Conversion failed.');
                return;
            }

            document.getElementById('resultOriginal').textContent =
                `${formatNumber(data.originalAmount)} ${data.originalCurrency}`;
            document.getElementById('resultConverted').textContent =
                `${formatNumber(data.convertedAmount)} ${data.targetCurrency}`;
            document.getElementById('resultRate').textContent =
                `Rate: 1 ${data.originalCurrency} = ${parseFloat(data.rate).toFixed(6)} ${data.targetCurrency}`;

            resultEl.classList.add('show');
        } catch (err) {
            showError('Network error. Please try again.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-left-right me-1"></i>Convert';
        }

        function showError(msg) {
            document.getElementById('convertErrorMsg').textContent = msg;
            errorEl.classList.add('show');
        }
    };

    // ── Swap currencies ─────────────────────
    window.swapCurrencies = function () {
        const from = document.getElementById('convertFrom');
        const to = document.getElementById('convertTo');
        const tmp = from.value;
        from.value = to.value;
        to.value = tmp;
    };

    // ── Sync ────────────────────────────────
    window.syncRates = async function () {
        const btn = document.getElementById('btnSync');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-inline"></span>Syncing…';

        try {
            const res = await fetch('{{ path("admin_exchange_rates_sync") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
            });

            const data = await res.json();

            if (!res.ok || data.error) {
                showToast(data.error || 'Sync failed.', 'danger');
                return;
            }

            showToast(`Synced ${data.updated} rates successfully.`, 'success');

            // Reload page after a short delay to show new data.
            setTimeout(() => window.location.reload(), 1200);
        } catch (err) {
            showToast('Network error during sync.', 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Sync Rates';
        }
    };

    // ── Table search / filter ───────────────
    window.filterTable = function () {
        const query = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.querySelectorAll('#ratesBody tr');
        let visible = 0;

        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            const match = text.includes(query);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
        });

        const footer = document.getElementById('tableFooter');
        if (footer) {
            footer.textContent = `Showing ${visible} of ${rows.length} pairs`;
        }
    };

    // ── Table sort ──────────────────────────
    let sortState = { col: -1, asc: true };

    window.sortTable = function (colIndex) {
        const table = document.getElementById('ratesTable');
        const tbody = document.getElementById('ratesBody');
        const rows = Array.from(tbody.querySelectorAll('tr'));

        if (sortState.col === colIndex) {
            sortState.asc = !sortState.asc;
        } else {
            sortState.col = colIndex;
            sortState.asc = true;
        }

        rows.sort((a, b) => {
            let aVal = a.children[colIndex].textContent.trim();
            let bVal = b.children[colIndex].textContent.trim();

            // Numeric sort for the Rate column (index 2).
            if (colIndex === 2) {
                return sortState.asc
                    ? parseFloat(aVal.replace(/,/g, '')) - parseFloat(bVal.replace(/,/g, ''))
                    : parseFloat(bVal.replace(/,/g, '')) - parseFloat(aVal.replace(/,/g, ''));
            }

            // String sort for other columns.
            return sortState.asc
                ? aVal.localeCompare(bVal)
                : bVal.localeCompare(aVal);
        });

        rows.forEach(row => tbody.appendChild(row));

        // Update header styling.
        table.querySelectorAll('thead th').forEach(th => th.classList.remove('sorted'));
        table.querySelector(`thead th[data-col="${colIndex}"]`).classList.add('sorted');

        // Update sort icon.
        const icon = table.querySelector(`thead th[data-col="${colIndex}"] .sort-icon`);
        icon.className = `bi sort-icon bi-arrow-${sortState.asc ? 'up' : 'down'}`;
    };

    // ── Helpers ──────────────────────────────
    function formatNumber(val) {
        const num = parseFloat(val);
        return isNaN(num) ? val : num.toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
        });
    }

    // Allow Enter key in converter form.
    document.getElementById('convertAmount')?.addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); doConvert(); }
    });
})();
</script>
{% endblock %}
