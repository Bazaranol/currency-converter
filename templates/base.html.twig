<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Currency Converter{% endblock %} — Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YcnS/1V8WB6lXpOYrV6qbFAav1JnKza+phhL"
          crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">

    <style>
        :root {
            --cc-primary: #2563eb;
            --cc-primary-light: #dbeafe;
            --cc-surface: #f8fafc;
            --cc-border: #e2e8f0;
            --cc-text: #1e293b;
            --cc-muted: #64748b;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--cc-surface);
            color: var(--cc-text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar {
            background: #fff !important;
            border-bottom: 1px solid var(--cc-border);
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: -.025em;
            color: var(--cc-primary) !important;
        }

        .navbar-brand i { margin-right: .4rem; }

        main { flex: 1; }

        .card {
            border: 1px solid var(--cc-border);
            border-radius: .75rem;
            box-shadow: 0 1px 2px rgba(0,0,0,.03);
        }

        .card-header {
            background: #fff;
            border-bottom: 1px solid var(--cc-border);
            font-weight: 600;
        }

        .table { margin-bottom: 0; }

        .table thead th {
            background: var(--cc-surface);
            border-bottom: 2px solid var(--cc-border);
            font-size: .8125rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--cc-muted);
            cursor: pointer;
            user-select: none;
            white-space: nowrap;
        }

        .table thead th:hover { color: var(--cc-primary); }

        .table thead th .sort-icon {
            opacity: .3;
            margin-left: .25rem;
            font-size: .75rem;
        }

        .table thead th.sorted .sort-icon { opacity: 1; color: var(--cc-primary); }

        .table tbody td {
            vertical-align: middle;
            font-size: .875rem;
        }

        .badge-currency {
            font-family: 'SF Mono', 'Cascadia Code', 'Fira Code', monospace;
            font-size: .8125rem;
            font-weight: 600;
            padding: .3em .65em;
            background: var(--cc-primary-light);
            color: var(--cc-primary);
            border-radius: .375rem;
        }

        .rate-value {
            font-family: 'SF Mono', 'Cascadia Code', 'Fira Code', monospace;
            font-weight: 500;
        }

        .stat-card {
            text-align: center;
            padding: 1.25rem 1rem;
        }

        .stat-card .stat-value {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--cc-primary);
            line-height: 1.2;
        }

        .stat-card .stat-label {
            font-size: .8125rem;
            color: var(--cc-muted);
            margin-top: .25rem;
        }

        .converter-result {
            display: none;
            animation: fadeIn .3s ease;
        }

        .converter-result.show { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-4px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .search-input {
            border-radius: .5rem;
            border: 1px solid var(--cc-border);
            padding: .5rem .75rem;
            font-size: .875rem;
        }

        .search-input:focus {
            border-color: var(--cc-primary);
            box-shadow: 0 0 0 3px rgba(37,99,235,.1);
        }

        .btn-sync {
            background: var(--cc-primary);
            color: #fff;
            border: none;
            border-radius: .5rem;
            font-weight: 600;
            padding: .5rem 1.25rem;
            transition: all .15s;
        }

        .btn-sync:hover { background: #1d4ed8; color: #fff; }
        .btn-sync:disabled { opacity: .6; cursor: not-allowed; }

        .spinner-inline {
            display: inline-block;
            width: 1rem;
            height: 1rem;
            border: 2px solid currentColor;
            border-right-color: transparent;
            border-radius: 50%;
            animation: spin .6s linear infinite;
            margin-right: .4rem;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        footer {
            border-top: 1px solid var(--cc-border);
            background: #fff;
            padding: 1rem 0;
            font-size: .8125rem;
            color: var(--cc-muted);
        }

        .toast-container { position: fixed; top: 1rem; right: 1rem; z-index: 9999; }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

{# ── Navbar ── #}
<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="{{ path('admin_exchange_rates_index') }}">
            <i class="bi bi-currency-exchange"></i>CurrencyAdmin
        </a>
        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="{{ path('admin_exchange_rates_index') }}">
                        <i class="bi bi-graph-up-arrow me-1"></i>Exchange Rates
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

{# ── Main content ── #}
<main class="container py-4">
    {% block body %}{% endblock %}
</main>

{# ── Footer ── #}
<footer>
    <div class="container text-center">
        Currency Converter &copy; {{ "now"|date("Y") }} &middot; Symfony {{ constant('Symfony\\Component\\HttpKernel\\Kernel::VERSION') }}
    </div>
</footer>

{# ── Toast container ── #}
<div class="toast-container" id="toastContainer"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>

<script>
    /**
     * Show a Bootstrap toast notification.
     * @param {string} message
     * @param {'success'|'danger'|'warning'} type
     */
    function showToast(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        const icons = { success: 'check-circle-fill', danger: 'exclamation-triangle-fill', warning: 'info-circle-fill' };
        const id = 'toast-' + Date.now();

        const html = `
            <div id="${id}" class="toast align-items-center text-bg-${type} border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-${icons[type] || icons.success} me-1"></i>${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>`;

        container.insertAdjacentHTML('beforeend', html);

        const el = document.getElementById(id);
        const toast = new bootstrap.Toast(el, { delay: 4000 });
        toast.show();
        el.addEventListener('hidden.bs.toast', () => el.remove());
    }
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
