# Environment variables for the test suite.
# Symfony loads .env first, then .env.test overrides.

APP_ENV=test
APP_SECRET=test_secret_not_for_production

# Separate test database — migrations run before test suite
DATABASE_URL="mysql://currency_user:currency_pass@db:3306/currency_converter_test?serverVersion=8.0&charset=utf8mb4"

# Same Redis, different DB index (db 1 instead of default 0)
REDIS_URL=redis://redis:6379/1
DEFAULT_URI=redis://redis:6379/1

# Cache TTL for tests (short-lived)
CACHE_EXCHANGE_RATES_TTL=60

# Fake API key for tests (real calls should be mocked)
FREECURRENCY_API_KEY=test_api_key_do_not_use
FREECURRENCY_API_BASE_URL=https://api.freecurrencyapi.com/v1
