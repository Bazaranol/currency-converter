# Currency Converter — scheduled tasks
#
# ── Setup options ──
#
# Option A: Host crontab (Docker)
#   0 6 * * * docker compose exec -T app php bin/console app:sync-exchange-rates >> /var/log/currency-sync.log 2>&1
#
# Option B: Inside app container
#   crontab /var/www/html/docker/cron/crontab
#
# Option C: Dedicated cron container (recommended for production)
#   Add a "cron" service in docker-compose.yml that shares the app image,
#   installs this crontab, and runs `cron -f` as entrypoint.

# ── Update exchange rates daily at 06:00 UTC ──
0 6 * * * cd /var/www/html && php bin/console app:sync-exchange-rates --no-interaction >> var/log/cron.log 2>&1

# ── Clean up old rate history monthly (keep 90 days) ──
# Uncomment when cleanup command is implemented:
# 0 4 1 * * cd /var/www/html && php bin/console app:exchange-rates:cleanup --days=90 >> var/log/cron.log 2>&1
